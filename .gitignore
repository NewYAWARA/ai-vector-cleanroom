# Python caches and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and previously bundled runtimes
.venv/
venv/
env/
python/
.beta6_runtime/

# User inputs, generated outputs, and regression residue
input/*
output/*
tests/_last_run/

# Private/formal validation and release work
validation/
real_world_validation/
release_work/
AI向量清稿工具_免安裝版v3_Codex_Beta.6/
AI向量清稿工具_免安裝版v3_Codex_Beta.6.zip
RELEASE_MANIFEST.json
RELEASE_RECEIPT*.json

# Internal checkpoints and handoff notes
PAUSE_CHECKPOINT_*.md
NEW_THREAD_HANDOFF_PROMPT_*.md

# Locks, staging, backup, and transient evidence
*.lock
*.tmp
*.bak
*_staging/
*_backup/
*_previous/
.jobs/
.failed_jobs/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Editors and operating systems
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Only generated public fixtures are included by the source allowlist.
tests/fixtures/*
!input/.gitkeep
!output/.gitkeep
